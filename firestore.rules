rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeRole(role) {
      return signedIn()
        && currentUser().role == role
        && currentUser().isActive == true;
    }

    function isSuperAdmin() {
      return activeRole('superAdmin');
    }

    function isBranchAdmin() {
      return activeRole('branchAdmin') && currentUser().branchId is string;
    }

    function isSameBranch(data) {
      return isSuperAdmin()
        || (isBranchAdmin()
          && data.branchId is string
          && data.branchId == currentUser().branchId);
    }

    function canAdministerUser(data) {
      return isSuperAdmin()
        || (isBranchAdmin()
          && data.branchId == currentUser().branchId
          && data.role in ['technician', 'customer']);
    }

    function canAdministerBooking(data) {
      return isSuperAdmin() || (isBranchAdmin() && isSameBranch(data));
    }

    function isTechnician() {
      return activeRole('technician');
    }

    function isCustomer() {
      return activeRole('customer');
    }

    function isPendingTechnician() {
      return signedIn()
        && currentUser().role == 'technician'
        && currentUser().accountStatus == 'pendingApproval';
    }

    // Location records are valid only after the same technician has checked
    // in successfully for the current work period. This prevents a client
    // from starting admin-visible tracking by writing a location directly.
    function hasRecentAttendanceForLocation(data) {
      return data.attendanceId is string
        && data.attendanceId.matches('^' + request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && exists(/databases/$(database)/documents/attendance/$(data.attendanceId))
        && get(/databases/$(database)/documents/attendance/$(data.attendanceId)).data.technicianId == request.auth.uid
        && get(/databases/$(database)/documents/attendance/$(data.attendanceId)).data.branchId == currentUser().branchId
        && get(/databases/$(database)/documents/attendance/$(data.attendanceId)).data.status in ['present', 'late']
        && request.time - get(/databases/$(database)/documents/attendance/$(data.attendanceId)).data.timestamp < duration.value(18, 'h');
    }

    function validLocationSample(data) {
      return data.latitude is number
        && data.latitude >= -90
        && data.latitude <= 90
        && data.longitude is number
        && data.longitude >= -180
        && data.longitude <= 180
        && data.accuracy is number
        && data.accuracy >= 0
        && data.accuracy <= 250
        && data.isMocked == false
        && data.capturedAt is timestamp
        && data.capturedAt <= request.time
        && request.time - data.capturedAt < duration.value(24, 'h')
        && data.updatedAt == request.time;
    }

    function booking(bookingId) {
      return get(/databases/$(database)/documents/bookings/$(bookingId)).data;
    }

    function branch(branchId) {
      return get(/databases/$(database)/documents/branches/$(branchId)).data;
    }

    function validFallbackBranch(data) {
      return (data.branchId == 'fallback-chennai'
          && data.branchName == 'FixNow Chennai')
        || (data.branchId == 'fallback-bengaluru'
          && data.branchName == 'FixNow Bengaluru')
        || (data.branchId == 'fallback-hyderabad'
          && data.branchName == 'FixNow Hyderabad');
    }

    function validServiceBranch(data) {
      return data.branchId is string
        && data.branchName is string
        && (validFallbackBranch(data)
          || (exists(/databases/$(database)/documents/branches/$(data.branchId))
            && data.branchName == branch(data.branchId).name
            && (!('isActive' in branch(data.branchId))
              || branch(data.branchId).isActive == true)));
    }

    function technicianRevenueBranch(technicianId) {
      return (userAfter(technicianId).nativeBranchId is string)
        ? userAfter(technicianId).nativeBranchId
        : userAfter(technicianId).branchId;
    }

    function userAfter(userId) {
      return getAfter(/databases/$(database)/documents/users/$(userId)).data;
    }

    function ownsBooking(data) {
      return isCustomer() && data.customerId == request.auth.uid;
    }

    function assignedBooking(data) {
      return isTechnician() && data.technicianId == request.auth.uid;
    }

    function hasNoTechnician(data) {
      return !('technicianId' in data) || data.technicianId == null;
    }

    function validTechnicianAssignment(data) {
      return !('technicianId' in data)
        || data.technicianId == null
        || (data.technicianId is string
          && exists(/databases/$(database)/documents/users/$(data.technicianId))
          && get(/databases/$(database)/documents/users/$(data.technicianId)).data.role
            == 'technician'
          && get(/databases/$(database)/documents/users/$(data.technicianId)).data.branchId
            == data.branchId
          && get(/databases/$(database)/documents/users/$(data.technicianId)).data.isActive
            == true
          && get(/databases/$(database)/documents/users/$(data.technicianId)).data.accountStatus
            == 'approved');
    }

    function isTechnicianBusyStatus(status) {
      return status in [
        'technicianAssigned',
        'accepted',
        'onTheWay',
        'arrived',
        'customerConfirmedArrival',
        'estimateSent',
        'estimateRejected',
        'estimateApproved',
        'serviceStarted',
        'workCompletedPendingCustomer'
      ];
    }

    function validActiveJobLock(bookingId, data) {
      return !isTechnicianBusyStatus(data.status)
        || (data.technicianId is string
          && existsAfter(/databases/$(database)/documents/technician_active_jobs/$(data.technicianId))
          && getAfter(/databases/$(database)/documents/technician_active_jobs/$(data.technicianId)).data.bookingId
            == bookingId
          && getAfter(/databases/$(database)/documents/technician_active_jobs/$(data.technicianId)).data.branchId
            == data.branchId);
    }

    function branchAdminBookingUpdate(bookingId) {
      return isBranchAdmin()
        && resource.data.branchId == currentUser().branchId
        && request.resource.data.branchId == currentUser().branchId
        && request.resource.data.branchName == resource.data.branchName
        && validTechnicianAssignment(request.resource.data)
        && validActiveJobLock(bookingId, request.resource.data);
    }

    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(fields);
    }

    function technicianTransition(from, to) {
      return assignedBooking(resource.data)
        && resource.data.status == from
        && request.resource.data.status == to
        && onlyChanges(['status', 'updatedAt']);
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if isSuperAdmin()
        || (isBranchAdmin()
          && (resource.data.branchId == currentUser().branchId
            || (resource.data.role == 'technician'
              && resource.data.nativeBranchId == currentUser().branchId)));
      allow get: if canAdministerUser(resource.data);
      allow create: if signedIn()
        && request.resource.data.uid == userId
        && (
          (request.resource.data.role == 'customer'
            && request.auth.uid == userId
            && request.resource.data.isActive == true
            && request.resource.data.accountStatus == 'approved')
          ||
          (request.resource.data.role == 'technician'
            && request.auth.uid == userId
            && request.resource.data.isActive == false
            && request.resource.data.accountStatus == 'pendingApproval'
            && request.resource.data.branchId is string
            && request.resource.data.branchName is string)
          ||
          (isSuperAdmin()
            && request.resource.data.role == 'branchAdmin'
            && request.resource.data.isActive == true
            && request.resource.data.accountStatus == 'approved'
            && request.resource.data.branchId is string
            && request.resource.data.branchName is string
            && request.resource.data.createdBy == request.auth.uid)
        );
      allow update: if isSuperAdmin()
        || (isBranchAdmin()
          && canAdministerUser(resource.data)
          && request.resource.data.role == resource.data.role
          && request.resource.data.branchId == resource.data.branchId
          && onlyChanges([
            'isActive',
            'accountStatus',
            'branchName',
            'approvedAt',
            'approvedBy',
            'rejectionReason',
            'rejectedAt',
            'rejectedBy',
            'inactivatedAt',
            'inactivatedBy',
            'inactivationReason',
            'reactivatedAt',
            'reactivatedBy',
            'technicianCategory',
            'monthlySalary',
            'updatedAt'
          ]))
        || (signedIn()
          && request.auth.uid == userId
          && onlyChanges([
            'name',
            'phone',
            'phoneNormalized',
            'profilePhoto',
            'branchId',
            'branchName',
            'faceReferencePhoto',
            'faceReferenceSignature',
            'faceReferenceUpdatedAt',
            'lastServiceAddress',
            'lastServiceLatitude',
            'lastServiceLongitude',
            'updatedAt'
          ]));
      // Technician accounts are permanent identities. Inactivation is the
      // only supported removal mechanism so linked operational history stays.
      allow delete: if isSuperAdmin() && resource.data.role != 'technician';
    }

    match /services/{serviceId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    match /app_config/{configId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    match /branches/{branchId} {
      allow read: if isSuperAdmin()
        || (isBranchAdmin() && branchId == currentUser().branchId)
        || isCustomer()
        || isTechnician()
        || isPendingTechnician();
      allow write: if isSuperAdmin();
    }

    match /bookings/{bookingId} {
      allow create: if ((isSuperAdmin()
          || (isBranchAdmin()
            && request.resource.data.branchId == currentUser().branchId))
        || (isCustomer()
          && request.resource.data.customerId == request.auth.uid
          && request.resource.data.status == 'booked'
          && (!('technicianId' in request.resource.data)
            || request.resource.data.technicianId == null)
          && (!('servicePhotos' in request.resource.data)
            || request.resource.data.servicePhotos.size() == 0)))
        && validServiceBranch(request.resource.data);

      allow read: if canAdministerBooking(resource.data)
        || ownsBooking(resource.data)
        || assignedBooking(resource.data);

      allow update: if (isSuperAdmin()
          && request.resource.data.branchId == resource.data.branchId
          && request.resource.data.branchName == resource.data.branchName
          && request.resource.data.branchId is string
          && validTechnicianAssignment(request.resource.data)
          && validActiveJobLock(bookingId, request.resource.data))
        || branchAdminBookingUpdate(bookingId)
        || (ownsBooking(resource.data)
          && resource.data.status == 'estimateSent'
          && request.resource.data.status == 'estimateApproved'
          && onlyChanges(['status', 'updatedAt']))
        || (ownsBooking(resource.data)
          && resource.data.status == 'estimateSent'
          && request.resource.data.status == 'estimateRejected'
          && onlyChanges(['status', 'updatedAt']))
        || (ownsBooking(resource.data)
          && resource.data.status in ['onTheWay', 'arrived']
          && request.resource.data.status == 'customerConfirmedArrival'
          && onlyChanges([
            'status',
            'customerConfirmedArrivalAt',
            'customerConfirmedLatitude',
            'customerConfirmedLongitude',
            'customerTechnicianDistanceMeters',
            'customerConfirmationDistanceWarning',
            'updatedAt'
          ]))
        || (ownsBooking(resource.data)
          && resource.data.status in ['onTheWay', 'arrived']
          && request.resource.data.status == resource.data.status
          && onlyChanges([
            'customerReportedNotMetAt',
            'updatedAt'
          ]))
        || (ownsBooking(resource.data)
          && resource.data.status == 'booked'
          && hasNoTechnician(resource.data)
          && request.resource.data.status == 'booked'
          && hasNoTechnician(request.resource.data)
          && onlyChanges(['preferredDate', 'preferredTime', 'updatedAt']))
        || (ownsBooking(resource.data)
          && resource.data.status == 'booked'
          && request.resource.data.status == 'booked'
          && hasNoTechnician(resource.data)
          && hasNoTechnician(request.resource.data)
          && request.resource.data.imageUrl is string
          && onlyChanges(['imageUrl', 'updatedAt']))
        || technicianTransition('technicianAssigned', 'accepted')
        || technicianTransition('accepted', 'onTheWay')
        || technicianTransition('onTheWay', 'arrived')
        || (assignedBooking(resource.data)
          && resource.data.status == 'onTheWay'
          && request.resource.data.status == 'arrived'
          && onlyChanges([
            'status',
            'technicianReachedAt',
            'technicianReachedByManualOverride',
            'technicianReachedLatitude',
            'technicianReachedLongitude',
            'technicianArrivalDistanceMeters',
            'updatedAt'
          ]))
        || technicianTransition('customerConfirmedArrival', 'estimateSent')
        || technicianTransition('estimateRejected', 'estimateSent')
        || technicianTransition('estimateApproved', 'serviceStarted')
        || (assignedBooking(resource.data)
          && resource.data.status == 'serviceStarted'
          && request.resource.data.status == 'workCompletedPendingCustomer'
          && onlyChanges([
            'status',
            'technicianCompletedWorkAt',
            'customerReportedWorkNotDoneAt',
            'updatedAt'
          ]))
        || (assignedBooking(resource.data)
          && resource.data.status == 'serviceCompleted'
          && !('customerConfirmedWorkCompletedAt' in resource.data)
          && request.resource.data.status == 'workCompletedPendingCustomer'
          && onlyChanges([
            'status',
            'technicianCompletedWorkAt',
            'customerReportedWorkNotDoneAt',
            'updatedAt'
          ]))
        || (signedIn()
          && resource.data.customerId == request.auth.uid
          && resource.data.status == 'workCompletedPendingCustomer'
          && request.resource.data.status == 'serviceCompleted'
          && onlyChanges([
            'status',
            'customerConfirmedWorkCompletedAt',
            'updatedAt'
          ]))
        || (ownsBooking(resource.data)
          && resource.data.status == 'serviceCompleted'
          && !('customerConfirmedWorkCompletedAt' in resource.data)
          && request.resource.data.status == 'serviceCompleted'
          && onlyChanges([
            'technicianCompletedWorkAt',
            'customerConfirmedWorkCompletedAt',
            'customerReportedWorkNotDoneAt',
            'updatedAt'
          ]))
        || (ownsBooking(resource.data)
          && resource.data.status == 'workCompletedPendingCustomer'
          && request.resource.data.status == resource.data.status
          && onlyChanges([
            'customerReportedWorkNotDoneAt',
            'updatedAt'
          ]))
          || technicianTransition('serviceCompleted', 'billGenerated')
          || (assignedBooking(resource.data)
            && resource.data.status == 'billGenerated'
            && request.resource.data.status == 'closed'
            && onlyChanges(['status', 'updatedAt']))
          || (signedIn()
            && resource.data.customerId == request.auth.uid
            && resource.data.status == 'billGenerated'
            && request.resource.data.status == 'closed'
            && onlyChanges(['status', 'updatedAt']))
        || (assignedBooking(resource.data)
          && resource.data.status == 'technicianAssigned'
          && request.resource.data.status == 'booked'
          && request.resource.data.technicianId == null
          && request.resource.data.technicianName == null
          && onlyChanges([
            'technicianId',
            'technicianName',
            'status',
            'updatedAt'
          ]))
        || (assignedBooking(resource.data)
          && request.resource.data.status == resource.data.status
          && onlyChanges(['servicePhotos']))
        || (assignedBooking(resource.data)
          && resource.data.status in [
            'technicianAssigned',
            'accepted',
            'estimateSent',
            'estimateRejected',
            'estimateApproved',
            'onTheWay',
            'arrived',
            'customerConfirmedArrival',
            'serviceStarted',
            'workCompletedPendingCustomer',
          ]
          && request.resource.data.status == 'onHold'
          && onlyChanges([
            'status',
            'holdReason',
            'heldFromStatus',
            'heldAt',
            'updatedAt',
          ]))
        || (assignedBooking(resource.data)
          && resource.data.status == 'onHold'
          && request.resource.data.status in [
            'technicianAssigned',
            'accepted',
            'estimateSent',
            'estimateRejected',
            'estimateApproved',
            'onTheWay',
            'arrived',
            'customerConfirmedArrival',
            'serviceStarted',
            'workCompletedPendingCustomer',
          ]
          && onlyChanges([
            'status',
            'holdReason',
            'heldFromStatus',
            'heldAt',
            'resumedAt',
            'updatedAt',
          ]));

      allow delete: if canAdministerBooking(resource.data)
        || (ownsBooking(resource.data)
          && resource.data.status == 'booked'
          && hasNoTechnician(resource.data));
    }

    match /estimates/{bookingId} {
      allow read: if canAdministerBooking(booking(bookingId))
        || (signedIn()
          && (booking(bookingId).customerId == request.auth.uid
            || booking(bookingId).technicianId == request.auth.uid));
      allow create, update: if isTechnician()
        && bookingId == request.resource.data.bookingId
        && request.resource.data.technicianId == request.auth.uid
        && request.resource.data.isApproved == false
        && booking(bookingId).technicianId == request.auth.uid
        && booking(bookingId).status in [
          'customerConfirmedArrival',
          'estimateRejected',
        ]
        && request.resource.data.labourCharge >= 0
        && request.resource.data.partsCharge >= 0
        && request.resource.data.labourCharge
          + request.resource.data.partsCharge > 0;
      allow update: if isCustomer()
        && booking(bookingId).customerId == request.auth.uid
        && resource.data.isApproved == false
        && request.resource.data.isApproved == true
        && onlyChanges(['isApproved', 'approvedAt']);
      allow update: if canAdministerBooking(booking(bookingId))
        && resource.data.isApproved == false
        && request.resource.data.isApproved == true
        && onlyChanges(['isApproved', 'approvedAt']);
      allow update: if isCustomer()
        && booking(bookingId).customerId == request.auth.uid
        && resource.data.isApproved == false
        && request.resource.data.isApproved == false
        && request.resource.data.isRejected == true
        && onlyChanges(['isApproved', 'isRejected', 'rejectedAt']);
      allow update: if canAdministerBooking(booking(bookingId))
        && resource.data.isApproved == false
        && request.resource.data.isApproved == false
        && request.resource.data.isRejected == true
        && onlyChanges(['isApproved', 'isRejected', 'rejectedAt']);
      allow delete: if canAdministerBooking(booking(bookingId));
    }

    match /bills/{bookingId} {
      allow read: if canAdministerBooking(booking(bookingId))
        || (isBranchAdmin()
          && (resource.data.branchId == currentUser().branchId
            || resource.data.revenueBranchId == currentUser().branchId))
        || (signedIn()
          && (resource.data.customerId == request.auth.uid
            || resource.data.technicianId == request.auth.uid));
      allow create: if isTechnician()
        && bookingId == request.resource.data.bookingId
        && request.resource.data.technicianId == request.auth.uid
        && request.resource.data.customerId == booking(bookingId).customerId
        && request.resource.data.branchId == booking(bookingId).branchId
        && request.resource.data.revenueBranchId
          == technicianRevenueBranch(request.auth.uid)
        && booking(bookingId).technicianId == request.auth.uid
        && booking(bookingId).status == 'serviceCompleted'
        && ('technicianCompletedWorkAt' in booking(bookingId))
        && ('customerConfirmedWorkCompletedAt' in booking(bookingId))
        && request.resource.data.amount > 0
        && request.resource.data.isPaid == false;
      // Permit a super admin to attach legacy bills to their service and
      // native revenue branches without changing any financial values.
      allow update: if isSuperAdmin()
        && onlyChanges(['branchId', 'revenueBranchId']);
        allow update: if isTechnician()
          && resource.data.technicianId == request.auth.uid
          && resource.data.isPaid == false
          && request.resource.data.isPaid == false
          && booking(bookingId).status == 'billGenerated'
          && request.resource.data.paymentConfirmedBy == request.auth.uid
        && request.resource.data.amountReceived == resource.data.amount
        && request.resource.data.paymentMode in [
          'cash',
          'upi',
          'card',
          'bankTransfer',
          'other',
        ]
          && onlyChanges([
            'paymentMode',
            'amountReceived',
            'paymentProofUrl',
            'paymentSubmittedAt',
            'paymentConfirmedAt',
            'paymentConfirmedBy',
            'updatedAt',
          ]);
      allow update: if signedIn()
        && resource.data.customerId == request.auth.uid
        && booking(bookingId).customerId == request.auth.uid
        && resource.data.isPaid == false
        && request.resource.data.isPaid == true
        && resource.data.paymentMode in [
          'cash',
          'upi',
          'card',
          'bankTransfer',
          'other',
        ]
        && resource.data.amountReceived == resource.data.amount
        && onlyChanges([
          'isPaid',
          'paidAt',
          'paymentApprovedAt',
          'paymentApprovedBy',
          'updatedAt',
        ]);
      allow update: if canAdministerBooking(booking(bookingId))
        && resource.data.isPaid == false
        && request.resource.data.isPaid == true
        && resource.data.paymentMode in [
          'cash',
          'upi',
          'card',
          'bankTransfer',
          'other',
        ]
        && resource.data.amountReceived == resource.data.amount
        && onlyChanges([
          'isPaid',
          'paidAt',
          'paymentApprovedAt',
          'paymentApprovedBy',
          'updatedAt',
        ]);
      allow delete: if isSuperAdmin()
        || (isBranchAdmin()
          && resource.data.branchId == currentUser().branchId);
    }

    match /reviews/{bookingId} {
      allow read: if isSuperAdmin()
        || (isBranchAdmin()
          && (resource.data.branchId == currentUser().branchId
            || resource.data.revenueBranchId == currentUser().branchId))
        || (signedIn()
          && (resource.data.customerId == request.auth.uid
            || resource.data.technicianId == request.auth.uid));
      allow create: if signedIn()
        && bookingId == request.resource.data.bookingId
        && !exists(/databases/$(database)/documents/reviews/$(bookingId))
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.technicianId
          == booking(bookingId).technicianId
        && request.resource.data.branchId == booking(bookingId).branchId
        && booking(bookingId).customerId == request.auth.uid
        && booking(bookingId).status in ['serviceCompleted', 'billGenerated', 'closed']
        && request.resource.data.reviewerRole == 'customer'
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'bookingId',
          'technicianId',
          'customerId',
          'branchId',
          'rating',
          'text',
          'reviewerRole',
          'reviewerId',
          'createdAt'
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow create: if (isSuperAdmin() || isBranchAdmin())
        && request.resource.data.bookingId == ''
        && request.resource.data.customerId == ''
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.reviewerRole == currentUser().role
        && request.resource.data.branchId is string
        && request.resource.data.revenueBranchId is string
        && (isSuperAdmin()
          || request.resource.data.branchId == currentUser().branchId)
        && request.resource.data.technicianId is string
        && get(/databases/$(database)/documents/users/$(request.resource.data.technicianId)).data.role
          == 'technician'
        && get(/databases/$(database)/documents/users/$(request.resource.data.technicianId)).data.branchId
          == request.resource.data.branchId
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if canAdministerBooking(booking(bookingId))
        || isSuperAdmin()
        || (isBranchAdmin()
          && resource.data.branchId == currentUser().branchId);
    }

    match /technician_incentives/{incentiveId} {
      allow read: if isSuperAdmin()
        || (isBranchAdmin()
          && resource.data.branchId == currentUser().branchId)
        || (isTechnician()
          && resource.data.technicianId == request.auth.uid);
      allow create: if (isSuperAdmin() || isBranchAdmin())
        && request.resource.data.technicianId is string
        && request.resource.data.branchId is string
        && request.resource.data.awardedBy == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.description is string
        && request.resource.data.awardedAt == request.time
        && (isSuperAdmin()
          || request.resource.data.branchId == currentUser().branchId)
        && get(/databases/$(database)/documents/users/$(request.resource.data.technicianId)).data.role
          == 'technician'
        && get(/databases/$(database)/documents/users/$(request.resource.data.technicianId)).data.branchId
          == request.resource.data.branchId
        && request.resource.data.revenueBranchId
          == technicianRevenueBranch(request.resource.data.technicianId);
      allow update, delete: if isSuperAdmin()
        || (isBranchAdmin()
          && resource.data.branchId == currentUser().branchId);
    }

    match /attendance/{attendanceId} {
      allow read: if isSuperAdmin()
        || (isBranchAdmin()
          && resource.data.branchId == currentUser().branchId)
        || (isTechnician() && resource.data.technicianId == request.auth.uid);
      allow create: if (isSuperAdmin()
          || (isBranchAdmin()
            && request.resource.data.branchId == currentUser().branchId))
        || ((isTechnician() || isPendingTechnician())
        && attendanceId.matches('^' + request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.technicianId == request.auth.uid
        && request.resource.data.branchId == currentUser().branchId
        && request.resource.data.faceMatchPassed is bool
        && request.resource.data.geofencePassed is bool
        && request.resource.data.status in [
          'present',
          'late',
          'face_failed',
          'absent'
        ]);
      allow update: if isSuperAdmin()
        || (isBranchAdmin()
          && resource.data.branchId == currentUser().branchId
          && request.resource.data.branchId == resource.data.branchId)
        || ((isTechnician() || isPendingTechnician())
          && attendanceId.matches('^' + request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && resource.data.technicianId == request.auth.uid
          && request.resource.data.technicianId == request.auth.uid
          && request.resource.data.branchId == currentUser().branchId
          && request.resource.data.faceMatchPassed is bool
          && request.resource.data.geofencePassed is bool
          && request.resource.data.status in [
            'present',
            'late',
            'face_failed',
            'absent'
          ]);
      allow delete: if isSuperAdmin()
        || (isBranchAdmin()
          && resource.data.branchId == currentUser().branchId);
    }

    match /technician_active_jobs/{technicianId} {
      allow read: if isSuperAdmin()
        // Assignment transactions must be able to read a technician's lock
        // even before that lock document exists. The create/update rule below
        // still constrains branch admins to bookings in their own branch.
        || isBranchAdmin()
        || (isTechnician() && technicianId == request.auth.uid);
      allow create, update: if (canAdministerBooking(request.resource.data)
          || (isTechnician() && technicianId == request.auth.uid))
        && request.resource.data.keys().hasOnly([
          'technicianId',
          'bookingId',
          'branchId',
          'updatedAt'
        ])
        && request.resource.data.technicianId == technicianId
        && request.resource.data.bookingId is string
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.technicianId
          == technicianId
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.branchId
          == request.resource.data.branchId
        && isTechnicianBusyStatus(
          getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status
        );
      allow delete: if resource.data.technicianId == technicianId
        && resource.data.bookingId is string
        && signedIn()
        && (isSuperAdmin()
          || (isBranchAdmin()
            && resource.data.branchId == currentUser().branchId)
          || (isTechnician() && technicianId == request.auth.uid))
        && !isTechnicianBusyStatus(
          getAfter(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.status
        )
        // The booking customer can release this technician's lock only in the
        // same transaction that records their work-completion confirmation.
        || (signedIn()
          && resource.data.bookingId is string
          && booking(resource.data.bookingId).customerId == request.auth.uid
          && getAfter(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.status
            == 'serviceCompleted'
          && getAfter(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.customerConfirmedWorkCompletedAt
            is timestamp);
    }

    match /technician_locations/{technicianId} {
      allow create: if isTechnician()
        && technicianId == request.auth.uid
        && request.resource.data.technicianId == request.auth.uid
        && request.resource.data.branchId == currentUser().branchId
        && hasRecentAttendanceForLocation(request.resource.data)
        && validLocationSample(request.resource.data)
        && (!('activeBookingId' in request.resource.data)
          || request.resource.data.activeBookingId == null
          || booking(request.resource.data.activeBookingId).technicianId
            == request.auth.uid);
      allow update: if isTechnician()
        && technicianId == request.auth.uid
        && request.resource.data.technicianId == request.auth.uid
        && request.resource.data.branchId == currentUser().branchId
        && hasRecentAttendanceForLocation(request.resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'latitude',
              'longitude',
              'accuracy',
              'capturedAt',
              'isMocked',
            ])
          || validLocationSample(request.resource.data))
        && (!('activeBookingId' in request.resource.data)
          || request.resource.data.activeBookingId == null
          || booking(request.resource.data.activeBookingId).technicianId
            == request.auth.uid);
      allow read: if isSuperAdmin()
        || (isBranchAdmin()
          && resource.data.branchId == currentUser().branchId)
        || (isTechnician() && technicianId == request.auth.uid)
          || (isCustomer()
            && resource.data.activeBookingId != null
            && booking(resource.data.activeBookingId).customerId
              == request.auth.uid
            && booking(resource.data.activeBookingId).status in [
              'onTheWay',
              'arrived',
            ]);

      match /history/{pointId} {
        allow create: if isTechnician()
          && technicianId == request.auth.uid
          && request.resource.data.technicianId == request.auth.uid
          && request.resource.data.branchId == currentUser().branchId
          && hasRecentAttendanceForLocation(request.resource.data)
          && validLocationSample(request.resource.data)
          && (request.resource.data.activeBookingId == null
            || booking(request.resource.data.activeBookingId).technicianId
              == request.auth.uid);
        allow read: if isSuperAdmin()
          || (isBranchAdmin()
            && resource.data.branchId == currentUser().branchId)
          || (isTechnician() && technicianId == request.auth.uid);
        allow update, delete: if false;
      }
    }

    match /technician_overtime/{overtimeId} {
      allow read: if isSuperAdmin()
        || (isBranchAdmin()
          && resource.data.branchId == currentUser().branchId)
        || (isTechnician()
          && resource.data.technicianId == request.auth.uid);
      allow create: if isTechnician()
        && request.resource.data.technicianId == request.auth.uid
        && request.resource.data.branchId == currentUser().branchId
        && overtimeId == request.auth.uid + '_'
          + request.resource.data.dateKey
        && request.resource.data.startedAt == request.time
        && request.resource.data.lastDetectedAt == request.time
        && request.resource.data.isActive == true
        && request.resource.data.extraBookingIds is list
        && request.resource.data.keys().hasOnly([
          'technicianId',
          'branchId',
          'dateKey',
          'startedAt',
          'lastDetectedAt',
          'isActive',
          'extraBookingIds',
        ]);
      allow update: if isTechnician()
        && resource.data.technicianId == request.auth.uid
        && resource.data.branchId == currentUser().branchId
        && request.resource.data.technicianId == resource.data.technicianId
        && request.resource.data.branchId == resource.data.branchId
        && request.resource.data.dateKey == resource.data.dateKey
        && request.resource.data.startedAt == resource.data.startedAt
        && request.resource.data.lastDetectedAt == request.time
        && request.resource.data.isActive in [true, false]
        && request.resource.data.extraBookingIds is list
        && request.resource.data.keys().hasOnly([
          'technicianId',
          'branchId',
          'dateKey',
          'startedAt',
          'lastDetectedAt',
          'isActive',
          'extraBookingIds',
        ]);
      allow delete: if false;
    }

    match /device_tokens/{tokenId} {
      allow read: if isSuperAdmin();
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read: if isSuperAdmin()
        || (isBranchAdmin()
          && ((resource.data.bookingId is string
              && booking(resource.data.bookingId).branchId
                == currentUser().branchId)
            || (resource.data.type == 'technicianRegistration'
              && resource.data.recipientRole == 'branchAdmin'
              && resource.data.branchId == currentUser().branchId)
            || (resource.data.type == 'technicianOvertimeStarted'
              && resource.data.recipientRole == 'branchAdmin'
              && resource.data.branchId == currentUser().branchId)))
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if signedIn()
        && ((resource.data.userId == request.auth.uid)
          || (isBranchAdmin()
            && resource.data.recipientRole == 'branchAdmin'
            && resource.data.branchId == currentUser().branchId))
        && onlyChanges(['isRead', 'readAt']);
      allow create: if (isSuperAdmin() || isBranchAdmin())
        && request.resource.data.type == 'technicianAssignment'
        && request.resource.data.bookingId is string
        && request.resource.data.userId is string
        && booking(request.resource.data.bookingId).technicianId
          == request.resource.data.userId
        && canAdministerBooking(booking(request.resource.data.bookingId))
        && request.resource.data.branchId
          == booking(request.resource.data.bookingId).branchId
        && request.resource.data.isRead == false
        && request.resource.data.keys().hasOnly([
          'userId',
          'bookingId',
          'branchId',
          'type',
          'title',
          'body',
          'isRead',
          'createdAt',
        ]);
      allow create: if signedIn()
        && userAfter(request.auth.uid).role == 'technician'
        && userAfter(request.auth.uid).accountStatus == 'pendingApproval'
        && userAfter(request.auth.uid).isActive == false
        && request.resource.data.userId
          == 'branch:' + userAfter(request.auth.uid).branchId
        && request.resource.data.recipientRole == 'branchAdmin'
        && request.resource.data.technicianId == request.auth.uid
        && request.resource.data.branchId
          == userAfter(request.auth.uid).branchId
        && request.resource.data.type == 'technicianRegistration'
        && request.resource.data.isRead == false
        && request.resource.data.keys().hasOnly([
          'userId',
          'recipientRole',
          'technicianId',
          'branchId',
          'type',
          'title',
          'body',
          'isRead',
          'createdAt',
        ]);
      allow create: if isTechnician()
        && request.resource.data.type == 'technicianOvertimeStarted'
        && request.resource.data.technicianId == request.auth.uid
        && request.resource.data.branchId == currentUser().branchId
        && request.resource.data.title == 'Working Overtime'
        && request.resource.data.isRead == false
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/technician_overtime/$(request.auth.uid + '_' + request.resource.data.dateKey))
        && getAfter(/databases/$(database)/documents/technician_overtime/$(request.auth.uid + '_' + request.resource.data.dateKey)).data.technicianId
          == request.auth.uid
        && ((request.resource.data.userId == request.auth.uid
            && request.resource.data.recipientRole == 'technician'
            && notificationId == 'overtime_' + request.auth.uid + '_'
              + request.resource.data.dateKey + '_technician')
          || (request.resource.data.userId
                == 'branch:' + currentUser().branchId
            && request.resource.data.recipientRole == 'branchAdmin'
            && notificationId == 'overtime_' + request.auth.uid + '_'
              + request.resource.data.dateKey + '_branch')
          || (request.resource.data.userId == 'role:superAdmin'
            && request.resource.data.recipientRole == 'superAdmin'
            && notificationId == 'overtime_' + request.auth.uid + '_'
              + request.resource.data.dateKey + '_super'))
        && request.resource.data.keys().hasOnly([
          'userId',
          'recipientRole',
          'technicianId',
          'branchId',
          'dateKey',
          'type',
          'title',
          'body',
          'isRead',
          'createdAt',
        ]);
      allow create: if isTechnician()
        && request.resource.data.bookingId is string
        && booking(request.resource.data.bookingId).technicianId
          == request.auth.uid
        && (request.resource.data.userId
          == booking(request.resource.data.bookingId).customerId
          || (request.resource.data.type == 'technicianReachedCustomer'
            && request.resource.data.userId == 'admin'))
        && request.resource.data.type in [
          'estimateSent',
          'billGenerated',
          'paymentSubmitted',
          'paymentConfirmed',
          'technicianReachedCustomer',
          'workCompletionRequested',
          'bookingOnHold',
          'bookingResumed',
        ]
        && request.resource.data.isRead == false
        && request.resource.data.keys().hasOnly([
          'userId',
          'bookingId',
          'type',
          'title',
          'body',
          'isRead',
          'createdAt',
        ]);
      allow create: if isTechnician()
        && request.resource.data.type == 'bookingOnHold'
        && request.resource.data.bookingId is string
        && booking(request.resource.data.bookingId).technicianId
          == request.auth.uid
        && request.resource.data.userId
          == 'branch:' + booking(request.resource.data.bookingId).branchId
        && request.resource.data.recipientRole == 'branchAdmin'
        && request.resource.data.technicianId == request.auth.uid
        && request.resource.data.branchId
          == booking(request.resource.data.bookingId).branchId
        && request.resource.data.isRead == false
        && request.resource.data.keys().hasOnly([
          'userId',
          'recipientRole',
          'technicianId',
          'branchId',
          'bookingId',
          'type',
          'title',
          'body',
          'isRead',
          'createdAt',
        ]);
      allow create: if isCustomer()
        && request.resource.data.bookingId is string
        && booking(request.resource.data.bookingId).customerId
          == request.auth.uid
        && (request.resource.data.userId
          == booking(request.resource.data.bookingId).technicianId
          || (request.resource.data.type == 'customerArrivalConfirmed'
            && request.resource.data.userId == 'admin')
          || (request.resource.data.type == 'customerReportedTechnicianNotMet'
            && request.resource.data.userId == 'admin')
          || (request.resource.data.type == 'customerWorkCompletedConfirmed'
            && request.resource.data.userId == 'admin')
          || (request.resource.data.type == 'customerReportedWorkNotDone'
            && request.resource.data.userId == 'admin'))
        && request.resource.data.type in [
          'estimateApproved',
          'estimateRejected',
          'customerArrivalConfirmed',
          'customerReportedTechnicianNotMet',
          'customerWorkCompletedConfirmed',
          'customerReportedWorkNotDone',
        ]
        && request.resource.data.isRead == false
        && request.resource.data.keys().hasOnly([
          'userId',
          'bookingId',
          'type',
          'title',
          'body',
          'isRead',
          'createdAt',
        ]);
      // Branch admins act for phone/manual customers who have no app account.
      allow create: if (isSuperAdmin() || isBranchAdmin())
        && request.resource.data.bookingId is string
        && canAdministerBooking(booking(request.resource.data.bookingId))
        && request.resource.data.userId
          == booking(request.resource.data.bookingId).technicianId
        && request.resource.data.type in [
          'estimateApproved',
          'estimateRejected',
          'customerArrivalConfirmed',
          'customerWorkCompletedConfirmed',
        ]
        && request.resource.data.isRead == false
        && request.resource.data.keys().hasOnly([
          'userId',
          'bookingId',
          'type',
          'title',
          'body',
          'isRead',
          'createdAt',
        ]);
      allow create: if isSuperAdmin()
        || (isBranchAdmin()
          && request.resource.data.branchId == currentUser().branchId
          && ((request.resource.data.bookingId is string
              && booking(request.resource.data.bookingId).branchId
                == currentUser().branchId)
            || (request.resource.data.type in [
                'technicianApproved',
                'technicianRejected',
              ]
              && request.resource.data.recipientRole == 'technician'
              && request.resource.data.technicianId
                == request.resource.data.userId
              && get(/databases/$(database)/documents/users/$(request.resource.data.technicianId)).data.branchId
                == currentUser().branchId
              && ((request.resource.data.type == 'technicianApproved'
                  && userAfter(request.resource.data.technicianId).accountStatus
                    == 'approved'
                  && userAfter(request.resource.data.technicianId).isActive
                    == true)
                || (request.resource.data.type == 'technicianRejected'
                  && userAfter(request.resource.data.technicianId).accountStatus
                    == 'rejected'
                  && userAfter(request.resource.data.technicianId).isActive
                    == false)))));
      allow delete: if isSuperAdmin()
        || (isBranchAdmin()
          && resource.data.bookingId is string
          && booking(resource.data.bookingId).branchId == currentUser().branchId);
    }

    match /analytics/{analyticsId} {
      allow read: if isSuperAdmin()
        || (isBranchAdmin()
          && resource.data.branchId == currentUser().branchId);
      allow write: if isSuperAdmin()
        || (isBranchAdmin()
          && request.resource.data.branchId == currentUser().branchId);
    }

    match /audit_logs/{auditId} {
      allow read: if isSuperAdmin();
      allow create: if ((isSuperAdmin()
          && request.resource.data.actorRole == 'superAdmin')
        || (isBranchAdmin()
          && request.resource.data.actorRole == 'branchAdmin'
          && request.resource.data.branchId == currentUser().branchId))
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.targetType is string
        && request.resource.data.targetId is string
        && request.resource.data.summary is string;
      allow update, delete: if false;
    }
  }
}
