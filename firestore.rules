rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeRole(role) {
      return signedIn()
        && currentUser().role == role
        && currentUser().isActive == true;
    }

    function isSuperAdmin() {
      return activeRole('superAdmin');
    }

    function isBranchAdmin() {
      return activeRole('branchAdmin') && currentUser().branchId is string;
    }

    function isSameBranch(data) {
      return isSuperAdmin()
        || (isBranchAdmin()
          && data.branchId is string
          && data.branchId == currentUser().branchId);
    }

    function canAdministerUser(data) {
      return isSuperAdmin()
        || (isBranchAdmin()
          && data.branchId == currentUser().branchId
          && data.role in ['technician', 'customer']);
    }

    function canAdministerBooking(data) {
      return isSuperAdmin() || (isBranchAdmin() && isSameBranch(data));
    }

    function isTechnician() {
      return activeRole('technician');
    }

    function isCustomer() {
      return activeRole('customer');
    }

    function isPendingTechnician() {
      return signedIn()
        && currentUser().role == 'technician'
        && currentUser().accountStatus == 'pendingApproval';
    }

    function booking(bookingId) {
      return get(/databases/$(database)/documents/bookings/$(bookingId)).data;
    }

    function branch(branchId) {
      return get(/databases/$(database)/documents/branches/$(branchId)).data;
    }

    function userAfter(userId) {
      return getAfter(/databases/$(database)/documents/users/$(userId)).data;
    }

    function ownsBooking(data) {
      return isCustomer() && data.customerId == request.auth.uid;
    }

    function assignedBooking(data) {
      return isTechnician() && data.technicianId == request.auth.uid;
    }

    function hasNoTechnician(data) {
      return !('technicianId' in data) || data.technicianId == null;
    }

    function validTechnicianAssignment(data) {
      return !('technicianId' in data)
        || data.technicianId == null
        || (data.technicianId is string
          && exists(/databases/$(database)/documents/users/$(data.technicianId))
          && get(/databases/$(database)/documents/users/$(data.technicianId)).data.role
            == 'technician'
          && get(/databases/$(database)/documents/users/$(data.technicianId)).data.branchId
            == data.branchId
          && get(/databases/$(database)/documents/users/$(data.technicianId)).data.isActive
            == true
          && get(/databases/$(database)/documents/users/$(data.technicianId)).data.accountStatus
            == 'approved');
    }

    function branchAdminBookingUpdate() {
      return isBranchAdmin()
        && resource.data.branchId == currentUser().branchId
        && request.resource.data.branchId == currentUser().branchId
        && request.resource.data.branchName == resource.data.branchName
        && validTechnicianAssignment(request.resource.data);
    }

    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(fields);
    }

    function technicianTransition(from, to) {
      return assignedBooking(resource.data)
        && resource.data.status == from
        && request.resource.data.status == to
        && onlyChanges(['status', 'updatedAt']);
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if isSuperAdmin()
        || (isBranchAdmin()
          && resource.data.branchId == currentUser().branchId);
      allow get: if canAdministerUser(resource.data);
      allow create: if signedIn()
        && request.resource.data.uid == userId
        && (
          (request.resource.data.role == 'customer'
            && request.auth.uid == userId
            && request.resource.data.isActive == true
            && request.resource.data.accountStatus == 'approved')
          ||
          (request.resource.data.role == 'technician'
            && request.auth.uid == userId
            && request.resource.data.isActive == false
            && request.resource.data.accountStatus == 'pendingApproval'
            && request.resource.data.branchId is string
            && request.resource.data.branchName is string)
          ||
          (isSuperAdmin()
            && request.resource.data.role == 'branchAdmin'
            && request.resource.data.isActive == true
            && request.resource.data.accountStatus == 'approved'
            && request.resource.data.branchId is string
            && request.resource.data.branchName is string
            && request.resource.data.createdBy == request.auth.uid)
        );
      allow update: if isSuperAdmin()
        || (isBranchAdmin()
          && canAdministerUser(resource.data)
          && request.resource.data.role == resource.data.role
          && request.resource.data.branchId == resource.data.branchId
          && onlyChanges([
            'isActive',
            'accountStatus',
            'branchName',
            'approvedAt',
            'approvedBy',
            'rejectionReason',
            'rejectedAt',
            'rejectedBy',
            'inactivatedAt',
            'inactivatedBy',
            'inactivationReason',
            'reactivatedAt',
            'reactivatedBy',
            'updatedAt'
          ]))
        || (signedIn()
          && request.auth.uid == userId
          && onlyChanges([
            'name',
            'phone',
            'profilePhoto',
            'branchId',
            'branchName',
            'faceReferencePhoto',
            'faceReferenceSignature',
            'faceReferenceUpdatedAt',
            'lastServiceAddress',
            'lastServiceLatitude',
            'lastServiceLongitude',
            'updatedAt'
          ]));
      // Technician accounts are permanent identities. Inactivation is the
      // only supported removal mechanism so linked operational history stays.
      allow delete: if isSuperAdmin() && resource.data.role != 'technician';
    }

    match /services/{serviceId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    match /app_config/{configId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    match /branches/{branchId} {
      allow read: if isSuperAdmin()
        || (isBranchAdmin() && branchId == currentUser().branchId)
        || isCustomer()
        || isTechnician()
        || isPendingTechnician();
      allow write: if isSuperAdmin();
    }

    match /bookings/{bookingId} {
      allow create: if ((isSuperAdmin()
          || (isBranchAdmin()
            && request.resource.data.branchId == currentUser().branchId))
        || (isCustomer()
          && request.resource.data.customerId == request.auth.uid
          && request.resource.data.status == 'booked'
          && (!('technicianId' in request.resource.data)
            || request.resource.data.technicianId == null)
          && (!('servicePhotos' in request.resource.data)
            || request.resource.data.servicePhotos.size() == 0)))
        && request.resource.data.branchId is string
        && request.resource.data.branchName is string
        && exists(/databases/$(database)/documents/branches/$(request.resource.data.branchId))
        && request.resource.data.branchName
          == branch(request.resource.data.branchId).name
        && (!('isActive' in branch(request.resource.data.branchId))
          || branch(request.resource.data.branchId).isActive == true);

      allow read: if canAdministerBooking(resource.data)
        || ownsBooking(resource.data)
        || assignedBooking(resource.data);

      allow update: if (isSuperAdmin()
          && request.resource.data.branchId == resource.data.branchId
          && request.resource.data.branchName == resource.data.branchName
          && request.resource.data.branchId is string)
        || branchAdminBookingUpdate()
        || (ownsBooking(resource.data)
          && resource.data.status == 'estimateSent'
          && request.resource.data.status == 'estimateApproved'
          && onlyChanges(['status', 'updatedAt']))
        || (ownsBooking(resource.data)
          && resource.data.status == 'estimateSent'
          && request.resource.data.status == 'estimateRejected'
          && onlyChanges(['status', 'updatedAt']))
        || (ownsBooking(resource.data)
          && resource.data.status == 'arrived'
          && request.resource.data.status == 'customerConfirmedArrival'
          && onlyChanges([
            'status',
            'customerConfirmedArrivalAt',
            'updatedAt'
          ]))
        || (ownsBooking(resource.data)
          && resource.data.status == 'arrived'
          && request.resource.data.status == resource.data.status
          && onlyChanges([
            'customerReportedNotMetAt',
            'updatedAt'
          ]))
        || (ownsBooking(resource.data)
          && resource.data.status == 'booked'
          && hasNoTechnician(resource.data)
          && request.resource.data.status == 'booked'
          && hasNoTechnician(request.resource.data)
          && onlyChanges(['preferredDate', 'preferredTime', 'updatedAt']))
        || technicianTransition('technicianAssigned', 'accepted')
        || technicianTransition('accepted', 'onTheWay')
        || technicianTransition('onTheWay', 'arrived')
        || (assignedBooking(resource.data)
          && resource.data.status == 'onTheWay'
          && request.resource.data.status == 'arrived'
          && onlyChanges([
            'status',
            'technicianReachedAt',
            'technicianReachedByManualOverride',
            'updatedAt'
          ]))
        || technicianTransition('customerConfirmedArrival', 'estimateSent')
        || technicianTransition('estimateRejected', 'estimateSent')
        || technicianTransition('estimateApproved', 'serviceStarted')
        || technicianTransition('serviceStarted', 'serviceCompleted')
        || technicianTransition('serviceCompleted', 'billGenerated')
        || technicianTransition('billGenerated', 'closed')
        || (assignedBooking(resource.data)
          && resource.data.status == 'technicianAssigned'
          && request.resource.data.status == 'booked'
          && request.resource.data.technicianId == null
          && request.resource.data.technicianName == null
          && onlyChanges([
            'technicianId',
            'technicianName',
            'status',
            'updatedAt'
          ]))
        || (assignedBooking(resource.data)
          && request.resource.data.status == resource.data.status
          && onlyChanges(['servicePhotos']));

      allow delete: if canAdministerBooking(resource.data)
        || (ownsBooking(resource.data)
          && resource.data.status == 'booked'
          && hasNoTechnician(resource.data));
    }

    match /estimates/{bookingId} {
      allow read: if canAdministerBooking(booking(bookingId))
        || (signedIn()
          && (booking(bookingId).customerId == request.auth.uid
            || booking(bookingId).technicianId == request.auth.uid));
      allow create, update: if isTechnician()
        && bookingId == request.resource.data.bookingId
        && request.resource.data.technicianId == request.auth.uid
        && request.resource.data.isApproved == false
        && booking(bookingId).technicianId == request.auth.uid
        && booking(bookingId).status in [
          'customerConfirmedArrival',
          'estimateRejected',
        ]
        && request.resource.data.labourCharge >= 0
        && request.resource.data.partsCharge >= 0
        && request.resource.data.labourCharge
          + request.resource.data.partsCharge > 0;
      allow update: if isCustomer()
        && booking(bookingId).customerId == request.auth.uid
        && resource.data.isApproved == false
        && request.resource.data.isApproved == true
        && onlyChanges(['isApproved', 'approvedAt']);
      allow update: if isCustomer()
        && booking(bookingId).customerId == request.auth.uid
        && resource.data.isApproved == false
        && request.resource.data.isApproved == false
        && request.resource.data.isRejected == true
        && onlyChanges(['isApproved', 'isRejected', 'rejectedAt']);
      allow delete: if canAdministerBooking(booking(bookingId));
    }

    match /bills/{bookingId} {
      allow read: if canAdministerBooking(booking(bookingId))
        || (isBranchAdmin()
          && resource.data.branchId == currentUser().branchId)
        || (signedIn()
          && (resource.data.customerId == request.auth.uid
            || resource.data.technicianId == request.auth.uid));
      allow create: if isTechnician()
        && bookingId == request.resource.data.bookingId
        && request.resource.data.technicianId == request.auth.uid
        && request.resource.data.customerId == booking(bookingId).customerId
        && request.resource.data.branchId == booking(bookingId).branchId
        && booking(bookingId).technicianId == request.auth.uid
        && booking(bookingId).status == 'serviceCompleted'
        && request.resource.data.amount > 0
        && request.resource.data.isPaid == false;
      allow update: if isTechnician()
        && resource.data.technicianId == request.auth.uid
        && resource.data.isPaid == false
        && request.resource.data.isPaid == true
        && booking(bookingId).status == 'billGenerated'
        && request.resource.data.paymentConfirmedBy == request.auth.uid
        && request.resource.data.paymentMode in [
          'cash',
          'upi',
          'card',
          'bankTransfer',
          'other',
        ]
        && onlyChanges([
          'isPaid',
          'paymentMode',
          'paymentSubmittedAt',
          'paymentConfirmedAt',
          'paymentConfirmedBy',
          'paidAt',
          'updatedAt',
        ]);
      allow update: if canAdministerBooking(booking(bookingId))
        && resource.data.isPaid == false
        && request.resource.data.isPaid == true
        && resource.data.paymentMode in [
          'cash',
          'upi',
          'card',
          'bankTransfer',
          'other',
        ]
        && onlyChanges([
          'isPaid',
          'paidAt',
          'paymentApprovedAt',
          'paymentApprovedBy',
          'updatedAt',
        ]);
      allow delete: if isSuperAdmin()
        || (isBranchAdmin()
          && resource.data.branchId == currentUser().branchId);
    }

    match /reviews/{bookingId} {
      allow read: if isSuperAdmin()
        || (isBranchAdmin()
          && resource.data.branchId == currentUser().branchId)
        || (signedIn()
          && (resource.data.customerId == request.auth.uid
            || resource.data.technicianId == request.auth.uid));
      allow create: if isCustomer()
        && bookingId == request.resource.data.bookingId
        && !exists(/databases/$(database)/documents/reviews/$(bookingId))
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.technicianId
          == booking(bookingId).technicianId
        && request.resource.data.branchId == booking(bookingId).branchId
        && booking(bookingId).customerId == request.auth.uid
        && booking(bookingId).status in ['serviceCompleted', 'billGenerated', 'closed']
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if canAdministerBooking(booking(bookingId));
    }

    match /attendance/{attendanceId} {
      allow read: if isSuperAdmin()
        || (isBranchAdmin()
          && resource.data.branchId == currentUser().branchId)
        || (isTechnician() && resource.data.technicianId == request.auth.uid);
      allow create: if (isSuperAdmin()
          || (isBranchAdmin()
            && request.resource.data.branchId == currentUser().branchId))
        || ((isTechnician() || isPendingTechnician())
        && attendanceId.matches('^' + request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.technicianId == request.auth.uid
        && request.resource.data.branchId == currentUser().branchId
        && request.resource.data.faceMatchPassed is bool
        && request.resource.data.geofencePassed is bool
        && request.resource.data.status in [
          'present',
          'late',
          'face_failed',
          'absent'
        ]);
      allow update: if isSuperAdmin()
        || (isBranchAdmin()
          && resource.data.branchId == currentUser().branchId
          && request.resource.data.branchId == resource.data.branchId)
        || ((isTechnician() || isPendingTechnician())
          && attendanceId.matches('^' + request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && resource.data.technicianId == request.auth.uid
          && request.resource.data.technicianId == request.auth.uid
          && request.resource.data.branchId == currentUser().branchId
          && request.resource.data.faceMatchPassed is bool
          && request.resource.data.geofencePassed is bool
          && request.resource.data.status in [
            'present',
            'late',
            'face_failed',
            'absent'
          ]);
      allow delete: if isSuperAdmin()
        || (isBranchAdmin()
          && resource.data.branchId == currentUser().branchId);
    }

    match /technician_locations/{technicianId} {
      allow write: if isTechnician()
        && technicianId == request.auth.uid
        && request.resource.data.technicianId == request.auth.uid
        && request.resource.data.branchId == currentUser().branchId
        && (!('activeBookingId' in request.resource.data)
          || request.resource.data.activeBookingId == null
          || booking(request.resource.data.activeBookingId).technicianId
            == request.auth.uid);
      allow read: if isSuperAdmin()
        || (isBranchAdmin()
          && resource.data.branchId == currentUser().branchId)
        || (isTechnician() && technicianId == request.auth.uid)
        || (isCustomer()
          && resource.data.activeBookingId != null
          && booking(resource.data.activeBookingId).customerId
            == request.auth.uid);

      match /history/{pointId} {
        allow create: if isTechnician()
          && technicianId == request.auth.uid
          && request.resource.data.technicianId == request.auth.uid
          && request.resource.data.branchId == currentUser().branchId
          && (request.resource.data.activeBookingId == null
            || booking(request.resource.data.activeBookingId).technicianId
              == request.auth.uid);
        allow read: if isSuperAdmin()
          || (isBranchAdmin()
            && resource.data.branchId == currentUser().branchId)
          || (isTechnician() && technicianId == request.auth.uid);
        allow update, delete: if false;
      }
    }

    match /technician_overtime/{overtimeId} {
      allow read: if isSuperAdmin()
        || (isBranchAdmin()
          && resource.data.branchId == currentUser().branchId)
        || (isTechnician()
          && resource.data.technicianId == request.auth.uid);
      allow create: if isTechnician()
        && request.resource.data.technicianId == request.auth.uid
        && request.resource.data.branchId == currentUser().branchId
        && overtimeId == request.auth.uid + '_'
          + request.resource.data.dateKey
        && request.resource.data.startedAt == request.time
        && request.resource.data.lastDetectedAt == request.time
        && request.resource.data.isActive == true
        && request.resource.data.extraBookingIds is list
        && request.resource.data.keys().hasOnly([
          'technicianId',
          'branchId',
          'dateKey',
          'startedAt',
          'lastDetectedAt',
          'isActive',
          'extraBookingIds',
        ]);
      allow update: if isTechnician()
        && resource.data.technicianId == request.auth.uid
        && resource.data.branchId == currentUser().branchId
        && request.resource.data.technicianId == resource.data.technicianId
        && request.resource.data.branchId == resource.data.branchId
        && request.resource.data.dateKey == resource.data.dateKey
        && request.resource.data.startedAt == resource.data.startedAt
        && request.resource.data.lastDetectedAt == request.time
        && request.resource.data.isActive in [true, false]
        && request.resource.data.extraBookingIds is list
        && request.resource.data.keys().hasOnly([
          'technicianId',
          'branchId',
          'dateKey',
          'startedAt',
          'lastDetectedAt',
          'isActive',
          'extraBookingIds',
        ]);
      allow delete: if false;
    }

    match /device_tokens/{tokenId} {
      allow read: if isSuperAdmin();
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read: if isSuperAdmin()
        || (isBranchAdmin()
          && ((resource.data.bookingId is string
              && booking(resource.data.bookingId).branchId
                == currentUser().branchId)
            || (resource.data.type == 'technicianRegistration'
              && resource.data.recipientRole == 'branchAdmin'
              && resource.data.branchId == currentUser().branchId)
            || (resource.data.type == 'technicianOvertimeStarted'
              && resource.data.recipientRole == 'branchAdmin'
              && resource.data.branchId == currentUser().branchId)))
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if signedIn()
        && ((resource.data.userId == request.auth.uid)
          || (isBranchAdmin()
            && resource.data.type == 'technicianRegistration'
            && resource.data.branchId == currentUser().branchId))
        && onlyChanges(['isRead', 'readAt']);
      allow create: if signedIn()
        && userAfter(request.auth.uid).role == 'technician'
        && userAfter(request.auth.uid).accountStatus == 'pendingApproval'
        && userAfter(request.auth.uid).isActive == false
        && request.resource.data.userId
          == 'branch:' + userAfter(request.auth.uid).branchId
        && request.resource.data.recipientRole == 'branchAdmin'
        && request.resource.data.technicianId == request.auth.uid
        && request.resource.data.branchId
          == userAfter(request.auth.uid).branchId
        && request.resource.data.type == 'technicianRegistration'
        && request.resource.data.isRead == false
        && request.resource.data.keys().hasOnly([
          'userId',
          'recipientRole',
          'technicianId',
          'branchId',
          'type',
          'title',
          'body',
          'isRead',
          'createdAt',
        ]);
      allow create: if isTechnician()
        && request.resource.data.type == 'technicianOvertimeStarted'
        && request.resource.data.technicianId == request.auth.uid
        && request.resource.data.branchId == currentUser().branchId
        && request.resource.data.title == 'Working Overtime'
        && request.resource.data.isRead == false
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/technician_overtime/$(request.auth.uid + '_' + request.resource.data.dateKey))
        && getAfter(/databases/$(database)/documents/technician_overtime/$(request.auth.uid + '_' + request.resource.data.dateKey)).data.technicianId
          == request.auth.uid
        && ((request.resource.data.userId == request.auth.uid
            && request.resource.data.recipientRole == 'technician'
            && notificationId == 'overtime_' + request.auth.uid + '_'
              + request.resource.data.dateKey + '_technician')
          || (request.resource.data.userId
                == 'branch:' + currentUser().branchId
            && request.resource.data.recipientRole == 'branchAdmin'
            && notificationId == 'overtime_' + request.auth.uid + '_'
              + request.resource.data.dateKey + '_branch')
          || (request.resource.data.userId == 'role:superAdmin'
            && request.resource.data.recipientRole == 'superAdmin'
            && notificationId == 'overtime_' + request.auth.uid + '_'
              + request.resource.data.dateKey + '_super'))
        && request.resource.data.keys().hasOnly([
          'userId',
          'recipientRole',
          'technicianId',
          'branchId',
          'dateKey',
          'type',
          'title',
          'body',
          'isRead',
          'createdAt',
        ]);
      allow create: if isTechnician()
        && request.resource.data.bookingId is string
        && booking(request.resource.data.bookingId).technicianId
          == request.auth.uid
        && (request.resource.data.userId
          == booking(request.resource.data.bookingId).customerId
          || (request.resource.data.type == 'technicianReachedCustomer'
            && request.resource.data.userId == 'admin'))
        && request.resource.data.type in [
          'estimateSent',
          'billGenerated',
          'paymentSubmitted',
          'paymentConfirmed',
          'technicianReachedCustomer',
        ]
        && request.resource.data.isRead == false
        && request.resource.data.keys().hasOnly([
          'userId',
          'bookingId',
          'type',
          'title',
          'body',
          'isRead',
          'createdAt',
        ]);
      allow create: if isCustomer()
        && request.resource.data.bookingId is string
        && booking(request.resource.data.bookingId).customerId
          == request.auth.uid
        && (request.resource.data.userId
          == booking(request.resource.data.bookingId).technicianId
          || (request.resource.data.type == 'customerArrivalConfirmed'
            && request.resource.data.userId == 'admin')
          || (request.resource.data.type == 'customerReportedTechnicianNotMet'
            && request.resource.data.userId == 'admin'))
        && request.resource.data.type in [
          'estimateApproved',
          'estimateRejected',
          'customerArrivalConfirmed',
          'customerReportedTechnicianNotMet',
        ]
        && request.resource.data.isRead == false
        && request.resource.data.keys().hasOnly([
          'userId',
          'bookingId',
          'type',
          'title',
          'body',
          'isRead',
          'createdAt',
        ]);
      allow create: if isSuperAdmin()
        || (isBranchAdmin()
          && request.resource.data.branchId == currentUser().branchId
          && ((request.resource.data.bookingId is string
              && booking(request.resource.data.bookingId).branchId
                == currentUser().branchId)
            || (request.resource.data.type in [
                'technicianApproved',
                'technicianRejected',
              ]
              && request.resource.data.recipientRole == 'technician'
              && request.resource.data.technicianId
                == request.resource.data.userId
              && get(/databases/$(database)/documents/users/$(request.resource.data.technicianId)).data.branchId
                == currentUser().branchId
              && ((request.resource.data.type == 'technicianApproved'
                  && userAfter(request.resource.data.technicianId).accountStatus
                    == 'approved'
                  && userAfter(request.resource.data.technicianId).isActive
                    == true)
                || (request.resource.data.type == 'technicianRejected'
                  && userAfter(request.resource.data.technicianId).accountStatus
                    == 'rejected'
                  && userAfter(request.resource.data.technicianId).isActive
                    == false)))));
      allow delete: if isSuperAdmin()
        || (isBranchAdmin()
          && resource.data.bookingId is string
          && booking(resource.data.bookingId).branchId == currentUser().branchId);
    }

    match /analytics/{analyticsId} {
      allow read: if isSuperAdmin()
        || (isBranchAdmin()
          && resource.data.branchId == currentUser().branchId);
      allow write: if isSuperAdmin()
        || (isBranchAdmin()
          && request.resource.data.branchId == currentUser().branchId);
    }

    match /audit_logs/{auditId} {
      allow read: if isSuperAdmin();
      allow create: if ((isSuperAdmin()
          && request.resource.data.actorRole == 'superAdmin')
        || (isBranchAdmin()
          && request.resource.data.actorRole == 'branchAdmin'
          && request.resource.data.branchId == currentUser().branchId))
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.targetType is string
        && request.resource.data.targetId is string
        && request.resource.data.summary is string;
      allow update, delete: if false;
    }
  }
}
