rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeRole(role) {
      return signedIn()
        && currentUser().role == role
        && currentUser().isActive == true;
    }

    function isAdmin() {
      return activeRole('admin');
    }

    function isTechnician() {
      return activeRole('technician');
    }

    function isCustomer() {
      return activeRole('customer');
    }

    function booking(bookingId) {
      return get(/databases/$(database)/documents/bookings/$(bookingId)).data;
    }

    function ownsBooking(data) {
      return isCustomer() && data.customerId == request.auth.uid;
    }

    function assignedBooking(data) {
      return isTechnician() && data.technicianId == request.auth.uid;
    }

    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(fields);
    }

    function technicianTransition(from, to) {
      return assignedBooking(resource.data)
        && resource.data.status == from
        && request.resource.data.status == to
        && onlyChanges(['status', 'updatedAt']);
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role == 'customer'
        && request.resource.data.isActive == true;
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == userId
          && onlyChanges(['name', 'phone', 'profilePhoto', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /app_config/{configId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow create: if isAdmin()
        || (isCustomer()
          && request.resource.data.customerId == request.auth.uid
          && request.resource.data.status == 'booked'
          && request.resource.data.technicianId == null
          && request.resource.data.servicePhotos.size() == 0);

      allow read: if isAdmin()
        || ownsBooking(resource.data)
        || assignedBooking(resource.data);

      allow update: if isAdmin()
        || (ownsBooking(resource.data)
          && resource.data.status == 'estimateSent'
          && request.resource.data.status == 'estimateApproved'
          && onlyChanges(['status', 'updatedAt']))
        || (ownsBooking(resource.data)
          && resource.data.status == 'booked'
          && resource.data.technicianId == null
          && request.resource.data.status == 'booked'
          && request.resource.data.technicianId == null
          && onlyChanges(['preferredDate', 'preferredTime', 'updatedAt']))
        || technicianTransition('technicianAssigned', 'accepted')
        || technicianTransition('accepted', 'onTheWay')
        || technicianTransition('onTheWay', 'arrived')
        || technicianTransition('arrived', 'estimateSent')
        || technicianTransition('estimateApproved', 'serviceStarted')
        || technicianTransition('serviceStarted', 'serviceCompleted')
        || technicianTransition('serviceCompleted', 'billGenerated')
        || (assignedBooking(resource.data)
          && resource.data.status == 'technicianAssigned'
          && request.resource.data.status == 'booked'
          && request.resource.data.technicianId == null
          && request.resource.data.technicianName == null
          && onlyChanges([
            'technicianId',
            'technicianName',
            'status',
            'updatedAt'
          ]))
        || (assignedBooking(resource.data)
          && request.resource.data.status == resource.data.status
          && onlyChanges(['servicePhotos']));

      allow delete: if isAdmin()
        || (ownsBooking(resource.data)
          && resource.data.status == 'booked'
          && resource.data.technicianId == null);
    }

    match /estimates/{bookingId} {
      allow read: if isAdmin()
        || (signedIn()
          && (booking(bookingId).customerId == request.auth.uid
            || booking(bookingId).technicianId == request.auth.uid));
      allow create, update: if isTechnician()
        && bookingId == request.resource.data.bookingId
        && request.resource.data.technicianId == request.auth.uid
        && request.resource.data.isApproved == false
        && booking(bookingId).technicianId == request.auth.uid
        && booking(bookingId).status == 'arrived'
        && request.resource.data.labourCharge >= 0
        && request.resource.data.partsCharge >= 0
        && request.resource.data.labourCharge
          + request.resource.data.partsCharge > 0;
      allow update: if isCustomer()
        && booking(bookingId).customerId == request.auth.uid
        && resource.data.isApproved == false
        && request.resource.data.isApproved == true
        && onlyChanges(['isApproved', 'approvedAt']);
      allow delete: if isAdmin();
    }

    match /bills/{bookingId} {
      allow read: if isAdmin()
        || (signedIn()
          && (resource.data.customerId == request.auth.uid
            || resource.data.technicianId == request.auth.uid));
      allow create: if isTechnician()
        && bookingId == request.resource.data.bookingId
        && request.resource.data.technicianId == request.auth.uid
        && request.resource.data.customerId == booking(bookingId).customerId
        && booking(bookingId).technicianId == request.auth.uid
        && booking(bookingId).status == 'serviceCompleted'
        && request.resource.data.amount > 0
        && request.resource.data.isPaid == false;
      allow update: if isAdmin()
        && resource.data.isPaid == false
        && request.resource.data.isPaid == true
        && onlyChanges(['isPaid', 'paidAt']);
      allow delete: if isAdmin();
    }

    match /reviews/{bookingId} {
      allow read: if isAdmin()
        || (signedIn()
          && (resource.data.customerId == request.auth.uid
            || resource.data.technicianId == request.auth.uid));
      allow create: if isCustomer()
        && bookingId == request.resource.data.bookingId
        && !exists(/databases/$(database)/documents/reviews/$(bookingId))
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.technicianId
          == booking(bookingId).technicianId
        && booking(bookingId).customerId == request.auth.uid
        && booking(bookingId).status in ['serviceCompleted', 'billGenerated', 'closed']
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if isAdmin()
        || (isTechnician() && resource.data.technicianId == request.auth.uid);
      allow create: if isTechnician()
        && attendanceId.matches('^' + request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.technicianId == request.auth.uid
        && request.resource.data.faceMatchPassed == false
        && request.resource.data.geofencePassed is bool;
      allow update, delete: if isAdmin();
    }

    match /technician_locations/{technicianId} {
      allow write: if isTechnician()
        && technicianId == request.auth.uid
        && request.resource.data.technicianId == request.auth.uid
        && (request.resource.data.activeBookingId == null
          || booking(request.resource.data.activeBookingId).technicianId
            == request.auth.uid);
      allow read: if isAdmin()
        || (isTechnician() && technicianId == request.auth.uid)
        || (isCustomer()
          && resource.data.activeBookingId != null
          && booking(resource.data.activeBookingId).customerId
            == request.auth.uid);
    }

    match /device_tokens/{tokenId} {
      allow read: if isAdmin();
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && onlyChanges(['isRead']);
      allow create, delete: if isAdmin();
    }

    match /analytics/{analyticsId} {
      allow read, write: if isAdmin();
    }
  }
}
