rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{folder}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && folder in [
          'attendance',
          'before_service',
          'during_service',
          'after_service',
          'profile_photos'
        ];
    }
  }
}
