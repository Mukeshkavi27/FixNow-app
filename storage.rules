rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function user() {
      return firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isSuperAdmin() {
      return signedIn()
        && user().role == 'superAdmin'
        && user().isActive == true;
    }

    function isBranchAdmin() {
      return signedIn()
        && user().role == 'branchAdmin'
        && user().isActive == true
        && user().branchId is string;
    }

    function userById(userId) {
      return firestore.get(
        /databases/(default)/documents/users/$(userId)
      ).data;
    }

    function canAdministerBranch(branchId) {
      return isSuperAdmin()
        || (isBranchAdmin() && user().branchId == branchId);
    }

    function booking(bookingId) {
      return firestore.get(
        /databases/(default)/documents/bookings/$(bookingId)
      ).data;
    }

    function canReadBooking(bookingId) {
      return signedIn()
        && (canAdministerBranch(booking(bookingId).branchId)
          || booking(bookingId).customerId == request.auth.uid
          || booking(bookingId).technicianId == request.auth.uid);
    }

    function isImageUpload() {
      return request.resource != null
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /customer_uploads/{userId}/{fileName} {
      allow read: if signedIn()
        && (request.auth.uid == userId
          || canAdministerBranch(userById(userId).branchId));
      allow write: if signedIn()
        && request.auth.uid == userId
        && isImageUpload();
    }

    match /attendance/{technicianId}/{fileName} {
      allow read: if signedIn()
        && (request.auth.uid == technicianId
          || canAdministerBranch(userById(technicianId).branchId));
      allow write: if signedIn()
        && request.auth.uid == technicianId
        && isImageUpload();
    }

    match /bookings/{bookingId}/{stage}/{fileName} {
      allow read: if canReadBooking(bookingId);
      allow write: if signedIn()
        && ((booking(bookingId).technicianId == request.auth.uid
            && stage in ['before', 'during', 'after'])
          || (booking(bookingId).customerId == request.auth.uid
            && stage == 'customer'))
        && isImageUpload();
    }

    match /payment_proofs/{bookingId}/{fileName} {
      allow read: if canReadBooking(bookingId);
      allow write: if signedIn()
        && booking(bookingId).technicianId == request.auth.uid
        && isImageUpload();
    }

    match /profile_photos/{userId}/{fileName} {
      allow read: if signedIn()
        && (request.auth.uid == userId
          || canAdministerBranch(userById(userId).branchId));
      allow write: if signedIn()
        && request.auth.uid == userId
        && isImageUpload();
    }
  }
}
